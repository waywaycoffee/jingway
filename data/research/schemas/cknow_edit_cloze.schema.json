{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jingway://research/cknow_edit_cloze",
  "title": "CKnowEdit cloze / literary knowledge prototype (research only)",
  "type": "object",
  "required": ["id", "prompt", "answer"],
  "properties": {
    "id": { "type": "string" },
    "grades": {
      "type": "array",
      "items": { "type": "integer", "minimum": 1, "maximum": 12 }
    },
    "prompt": { "type": "string", "description": "Stem with ____ blank" },
    "answer": { "type": "string" },
    "genre": {
      "type": "string",
      "enum": ["poetry_cloze", "literary_knowledge", "other"]
    }
  }
}
