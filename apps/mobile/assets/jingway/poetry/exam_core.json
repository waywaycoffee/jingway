{
  "version": 2,
  "source": "chinese-poetry public-domain texts; curated exam subset + tangshisanbaishou",
  "items": [
    {
      "id": "jingye_si",
      "title": "静夜思",
      "author": "李白",
      "dynasty": "唐",
      "grades": [
        1,
        2,
        3,
        4,
        5,
        6,
        7
      ],
      "lines": [
        "床前明月光",
        "疑是地上霜",
        "举头望明月",
        "低头思故乡"
      ]
    },
    {
      "id": "chun_xiao",
      "title": "春晓",
      "author": "孟浩然",
      "dynasty": "唐",
      "grades": [
        1,
        2,
        3,
        4,
        5,
        6
      ],
      "lines": [
        "春眠不觉晓",
        "处处闻啼鸟",
        "夜来风雨声",
        "花落知多少"
      ]
    },
    {
      "id": "deng_guanquelou",
      "title": "登鹳雀楼",
      "author": "王之涣",
      "dynasty": "唐",
      "grades": [
        2,
        3,
        4,
        5,
        6,
        7
      ],
      "lines": [
        "白日依山尽",
        "黄河入海流",
        "欲穷千里目",
        "更上一层楼"
      ]
    },
    {
      "id": "wang_yue",
      "title": "望岳",
      "author": "杜甫",
      "dynasty": "唐",
      "grades": [
        7,
        8,
        9
      ],
      "lines": [
        "岱宗夫如何",
        "齐鲁青未了",
        "造化钟神秀",
        "阴阳割昏晓",
        "荡胸生曾云",
        "决眦入归鸟",
        "会当凌绝顶",
        "一览众山小"
      ]
    },
    {
      "id": "ci_cheng",
      "title": "次北固山下",
      "author": "王湾",
      "dynasty": "唐",
      "grades": [
        7,
        8
      ],
      "lines": [
        "客路青山外",
        "行舟绿水前",
        "潮平两岸阔",
        "风正一帆悬",
        "海日生残夜",
        "江春入旧年",
        "乡书何处达",
        "归雁洛阳边"
      ]
    },
    {
      "id": "lunyu_xueer",
      "title": "论语·学而（节选）",
      "author": "孔子",
      "dynasty": "春秋",
      "grades": [
        7,
        8,
        9
      ],
      "lines": [
        "学而时习之",
        "不亦说乎",
        "有朋自远方来",
        "不亦乐乎",
        "人不知而不愠",
        "不亦君子乎"
      ]
    },
    {
      "id": "xiangsi",
      "title": "相思",
      "author": "王维",
      "dynasty": "唐",
      "grades": [
        3,
        4,
        5,
        6,
        7
      ],
      "lines": [
        "红豆生南国",
        "春来发几枝",
        "愿君多采撷",
        "此物最相思"
      ]
    },
    {
      "id": "min_nong",
      "title": "悯农（其一）",
      "author": "李绅",
      "dynasty": "唐",
      "grades": [
        1,
        2,
        3,
        4
      ],
      "lines": [
        "锄禾日当午",
        "汗滴禾下土",
        "谁知盘中餐",
        "粒粒皆辛苦"
      ]
    },
    {
      "id": "ye_yu_ji_bei",
      "title": "夜雨寄北",
      "author": "李商隐",
      "dynasty": "唐",
      "grades": [
        7,
        8,
        9
      ],
      "lines": [
        "君问归期未有期",
        "巴山夜雨涨秋池",
        "何当共剪西窗烛",
        "却话巴山夜雨时"
      ]
    },
    {
      "id": "huang_he_lou",
      "title": "黄鹤楼送孟浩然之广陵",
      "author": "李白",
      "dynasty": "唐",
      "grades": [
        7,
        8
      ],
      "lines": [
        "故人西辞黄鹤楼",
        "烟花三月下扬州",
        "孤帆远影碧空尽",
        "唯见长江天际流"
      ]
    },
    {
      "id": "wang_lu_shan_pu_bu",
      "title": "望庐山瀑布",
      "author": "李白",
      "dynasty": "唐",
      "grades": [
        3,
        4,
        5,
        6,
        7
      ],
      "lines": [
        "日照香炉生紫烟",
        "遥看瀑布挂前川",
        "飞流直下三千尺",
        "疑是银河落九天"
      ]
    },
    {
      "id": "zao_fa_baidicheng",
      "title": "早发白帝城",
      "author": "李白",
      "dynasty": "唐",
      "grades": [
        4,
        5,
        6,
        7
      ],
      "lines": [
        "朝辞白帝彩云间",
        "千里江陵一日还",
        "两岸猿声啼不住",
        "轻舟已过万重山"
      ]
    },
    {
      "id": "jiang_xue",
      "title": "江雪",
      "author": "柳宗元",
      "dynasty": "唐",
      "grades": [
        4,
        5,
        6,
        7
      ],
      "lines": [
        "千山鸟飞绝",
        "万径人踪灭",
        "孤舟蓑笠翁",
        "独钓寒江雪"
      ]
    },
    {
      "id": "feng_qiao_ye_bo",
      "title": "枫桥夜泊",
      "author": "张继",
      "dynasty": "唐",
      "grades": [
        5,
        6,
        7,
        8
      ],
      "lines": [
        "月落乌啼霜满天",
        "江枫渔火对愁眠",
        "姑苏城外寒山寺",
        "夜半钟声到客船"
      ]
    },
    {
      "id": "you_zi_yin",
      "title": "游子吟",
      "author": "孟郊",
      "dynasty": "唐",
      "grades": [
        4,
        5,
        6,
        7
      ],
      "lines": [
        "慈母手中线",
        "游子身上衣",
        "临行密密缝",
        "意恐迟迟归",
        "谁言寸草心",
        "报得三春晖"
      ]
    },
    {
      "id": "qiu_si",
      "title": "秋思",
      "author": "马致远",
      "dynasty": "元",
      "grades": [
        7,
        8,
        9
      ],
      "lines": [
        "枯藤老树昏鸦",
        "小桥流水人家",
        "古道西风瘦马",
        "夕阳西下",
        "断肠人在天涯"
      ]
    },
    {
      "id": "shui_diao_ge_tou",
      "title": "水调歌头·明月几时有（节选）",
      "author": "苏轼",
      "dynasty": "宋",
      "grades": [
        8,
        9
      ],
      "lines": [
        "明月几时有",
        "把酒问青天",
        "不知天上宫阙",
        "今夕是何年",
        "我欲乘风归去",
        "又恐琼楼玉宇",
        "高处不胜寒",
        "起舞弄清影",
        "何似在人间"
      ]
    },
    {
      "id": "qing_ping_yue_cun_ju",
      "title": "清平乐·村居",
      "author": "辛弃疾",
      "dynasty": "宋",
      "grades": [
        5,
        6,
        7
      ],
      "lines": [
        "茅檐低小",
        "溪上青青草",
        "醉里吴音相媚好",
        "白发谁家翁媪",
        "大儿锄豆溪东",
        "中儿正织鸡笼",
        "最喜小儿亡赖",
        "溪头卧剥莲蓬"
      ]
    },
    {
      "id": "za_shi",
      "title": "杂诗",
      "author": "王维",
      "dynasty": "唐",
      "grades": [
        6,
        7
      ],
      "lines": [
        "君自故乡来",
        "应知故乡事",
        "来日绮窗前",
        "寒梅着花未"
      ]
    },
    {
      "id": "zhu_li_guan",
      "title": "竹里馆",
      "author": "王维",
      "dynasty": "唐",
      "grades": [
        5,
        6,
        7
      ],
      "lines": [
        "独坐幽篁里",
        "弹琴复长啸",
        "深林人不知",
        "明月来相照"
      ]
    },
    {
      "id": "fu_rong_lou_song_xin_jian",
      "title": "芙蓉楼送辛渐",
      "author": "王昌龄",
      "dynasty": "唐",
      "grades": [
        7,
        8
      ],
      "lines": [
        "寒雨连江夜入吴",
        "平明送客楚山孤",
        "洛阳亲友如相问",
        "一片冰心在玉壶"
      ]
    },
    {
      "id": "jiu_yue_jiu_ri_yi_shan_dong",
      "title": "九月九日忆山东兄弟",
      "author": "王维",
      "dynasty": "唐",
      "grades": [
        5,
        6,
        7
      ],
      "lines": [
        "独在异乡为异客",
        "每逢佳节倍思亲",
        "遥知兄弟登高处",
        "遍插茱萸少一人"
      ]
    },
    {
      "id": "liang_zhou_ci",
      "title": "凉州词",
      "author": "王翰",
      "dynasty": "唐",
      "grades": [
        4,
        5,
        6,
        7
      ],
      "lines": [
        "葡萄美酒夜光杯",
        "欲饮琵琶马上催",
        "醉卧沙场君莫笑",
        "古来征战几人回"
      ]
    }
  ]
}
